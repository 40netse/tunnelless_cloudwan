# Terraform state — contains sensitive resource data, never commit
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform lock file for in-progress operations
.terraform.tfstate.lock.info

# Terraform working directory (providers, modules cache)
.terraform/

# Variable files that may contain secrets
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files (local dev overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (may contain sensitive values)
*.tfplan
*.tfplan.json

# Claude Code local settings
.claude/
