# Terraform state — contains sensitive resource data, never commit
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform lock file for in-progress operations
.terraform.tfstate.lock.info

# Terraform working directory (providers, modules cache)
.terraform/

# Variable files that may contain secrets
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files (local dev overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (may contain sensitive values)
*.tfplan
*.tfplan.json

# Claude Code local settings
.claude/

# Local environment variables (FortiFlex credentials, etc.)
.env
.env.*

# Deploy logs, reports, and state
deploy_log_*.txt
deploy_report_*.txt
.deploy_state.env

# Network diagrams (generated artifacts)
network_diagram.md
network_diagram.svg
